        {"roots": ["AJ507799.2"]},
        {"assembly": "GCA_000786075.2", "roles": ["unplaced-scaffold"]},
        {"collection": "IMGT/HLA 3.18.0", "groups": ["A", "B", "C", "DQA", "DQB", "DRB1"]}
      ],
      "mask": [{"layer": "hardmask_grc", "with": "N"}],
      "rename": {"namespace": "ucsc", "map": {"AJ507799.2": "chrEBV"},
                 "template": {"GCA_000786075.2": "chrUn_{accession_v}_decoy",
                              "IMGT/HLA 3.18.0": "HLA-{name}"}},
      "order": ["select", "role", "assembly_unit", "molecule", "object_rank"],
      "format": {"case": "upper", "line_width": 100}
    },
