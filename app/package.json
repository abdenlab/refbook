{
  "name": "refbook-app",
  "private": true,
  "version": "0.0.0",
  "description": "refbook's web app: the catalog, each edition's recipe, identity and sequences, in the browser",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --fail-on-warnings && tsc --noEmit && vite build",
    "check": "svelte-check",
    "preview": "vite preview",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@abdenlab/refbook": "workspace:*",
    "hyparquet": "^1.32.0",
    "hyparquet-compressors": "^1.1.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
