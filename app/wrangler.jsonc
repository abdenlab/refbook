// The app as a static-assets-only Cloudflare Worker, deployed by .github/workflows/app.yml at
// https://refbook.abdenlab.org (as abdenlab/lefsim's demo is).
{
  "name": "refbook",
  "compatibility_date": "2026-10-01",
  // Vite's build output. The app routes by hash (#/catalog/...), so every page is index.html.
  "assets": { "directory": "./dist" },
  // The custom domain: Cloudflare creates its DNS record and certificate on the first deploy (which fails if a
  // record for it already exists).
  "routes": [{ "pattern": "refbook.abdenlab.org", "custom_domain": true }],
  // One canonical URL: no *.workers.dev address or preview URLs (for the private beta, Cloudflare Access on the
  // custom domain then covers everything).
  "workers_dev": false,
  "preview_urls": false,
}
